<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <!-- iOS 18+: camera capture graph lives in cameracaptured daemon -->
        <!-- iOS ≤17: camera capture graph lives in mediaserverd daemon    -->
        <key>Executables</key>
        <array>
            <string>cameracaptured</string>
            <string>mediaserverd</string>
        </array>
    </dict>
</dict>
</plist>
