#!/bin/sh
set -e

# The shared files (config, media, shared memory) are NOT created here anymore.
#
# They live under the jailbreak root, which the app and daemon resolve at runtime
# through libroot -- and a maintainer script cannot resolve that path reliably
# (it is randomized on roothide, and scripts are not path-rewritten). So the app
# and daemon create the directory and files on demand, world-accessible, at the
# one location all components agree on. Seeding them here, at the bare
# /var/mobile/Library path, only created stray files the daemon never reads --
# which is the bug this whole change set fixes. Runtime seeding (VCamConfig
# defaults, plus the shared-memory magic/version reinitialise) covers a fresh
# install.

# Register the app so it appears without a respring. PATH-based: uicache lives at
# a different absolute path on rootful vs rootless/roothide.
uicache --all >/dev/null 2>&1 || uicache >/dev/null 2>&1 || true

# Force the capture daemon to respawn so it picks up the newly installed dylib.
# launchd brings it straight back, injected, the next time a camera opens; any
# app mid-capture simply restarts its session. If injection into the daemon does
# not take after this, a userspace reboot is the reliable fix (the companion
# app's Diagnostics screen will show whether the dylib loaded).
killall cameracaptured >/dev/null 2>&1 || true
killall mediaserverd  >/dev/null 2>&1 || true

exit 0
