#!/bin/sh
set -e

# The imported media and config under the jailbreak root are deliberately left
# in place: this script cannot resolve that path, and a reinstall should not lose
# the user's settings. To wipe everything, delete the tweak's directory by hand.

uicache --all >/dev/null 2>&1 || uicache >/dev/null 2>&1 || true

killall cameracaptured >/dev/null 2>&1 || true
killall mediaserverd  >/dev/null 2>&1 || true

exit 0
