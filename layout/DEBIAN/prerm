#!/bin/sh
set -e

# The shared files live under the jailbreak root, which this script cannot
# resolve, so disabling via the plist here is not possible. It does not matter:
# once the dylibs are removed the daemon stops substituting on its next spawn,
# and the respawn below makes that immediate. The runtime kill switch is for
# boot-loop recovery, not uninstall.

killall cameracaptured >/dev/null 2>&1 || true
killall mediaserverd  >/dev/null 2>&1 || true

exit 0
