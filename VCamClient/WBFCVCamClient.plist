<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <!-- Only loads where AVFoundation is actually present, which keeps this
             out of the vast majority of system daemons. -->
        <key>Bundles</key>
        <array>
            <string>com.apple.AVFoundation</string>
        </array>
        <key>Classes</key>
        <array>
            <string>AVCaptureSession</string>
        </array>
        <key>Mode</key>
        <string>Any</string>
    </dict>
</dict>
</plist>
